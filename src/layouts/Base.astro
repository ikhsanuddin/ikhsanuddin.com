---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  publishedTime?: string;
  noindex?: boolean;
}

const SITE_NAME = "Ikhsanuddin";
const DEFAULT_TITLE = "Ikhsanuddin Syamsuri - Senior Software Engineer";
const DEFAULT_DESCRIPTION =
  "Senior software engineer in Jakarta (UTC+7). AI-assisted product features in React and Ruby on Rails, PixiJS/WebGL canvas work, 10 years of web products.";
const DEFAULT_OG_IMAGE =
  "https://ik.imagekit.io/ikhsanuddin/profile/ikhsanuddin?tr=w-1080";

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  ogType = "website",
  ogImage = DEFAULT_OG_IMAGE,
  publishedTime,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Link previews (LinkedIn, Slack) need an absolute og:image URL.
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en" class="scheme-light dark:scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      content="#f4e7e1"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0c0c0c"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/logo192.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-59YQR2F3HF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-59YQR2F3HF");

      // Meaningful measurement: contact intent and finished reads,
      // not just pageviews.
      document.addEventListener("click", (e) => {
        const a = e.target.closest && e.target.closest("a[href]");
        if (!a) return;
        const href = a.getAttribute("href") || "";
        if (href.startsWith("mailto:")) {
          gtag("event", "contact_click", { method: "email" });
        } else if (a.hostname && a.hostname !== location.hostname) {
          const method = /linkedin/.test(a.hostname)
            ? "linkedin"
            : /github/.test(a.hostname)
              ? "github"
              : "outbound";
          gtag("event", "contact_click", { method, link_url: a.href });
        }
      });

      // article_read: fires once when a blog post is read to the end.
      window.addEventListener("DOMContentLoaded", () => {
        if (!/^\/blog\/[^/]+\/?$/.test(location.pathname)) return;
        const article = document.querySelector("article");
        if (!article) return;
        const sentinel = document.createElement("span");
        article.appendChild(sentinel);
        const io = new IntersectionObserver(([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          gtag("event", "article_read", {
            article_slug: location.pathname,
            article_title: document.title,
          });
        });
        io.observe(sentinel);
      });
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_US" />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Apply saved theme before first paint to avoid flashing -->
    <script is:inline>
      const theme =
        localStorage.getItem("theme") ??
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-60 focus:rounded-md focus:bg-light-bg focus:px-4 focus:py-2 dark:focus:bg-dark-bg"
    >
      Skip to content
    </a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
