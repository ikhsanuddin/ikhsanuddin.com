---
import Base from "@/layouts/Base.astro";
import DotGrid from "@/components/DotGrid.astro";
import Icon from "@/components/icons/Icon.astro";

const experiences = [
  {
    period: "February 2026 - Present",
    title: "Full-Stack Engineer",
    company: "Boon (getboon.ai), US (Remote)",
    bullets: [
      "Build AI-assisted features for construction preconstruction, including document analysis and bid generation, on a takeoff system that handled 70,000+ takeoff runs in 90 days. Customers report bill-of-materials prep dropping from 2-3 days to about 1.5 hours.",
      "Built the guided onboarding for new Boon Agent users, including generated use-case tiles, a default-deny integration contract for skill runs, and trial-scoped OAuth.",
      "Led the Takeoff V2 move of the blueprint canvas from a React component graph to a PixiJS/WebGL renderer, with an rbush spatial index, a tiled rendering pipeline with level of detail, and crisp zoom at V1 parity.",
      "In the V2 prototype, on a page with 1,366 annotations, cut click-to-select from 591 ms to 1.9 ms, took panning from a 45-second freeze to 55.7 fps, and cut JS heap from 222-244 MB to 116 MB.",
      "Planned and measured the trial funnel and its metrics, with Amplitude instrumentation and UTM attribution.",
      "Contributed to 65% of the third-party integrations, including Procore, Egnyte, Outlook, and Google.",
      "Own product features end to end across interface design, application logic, deployment, and monitoring, in React and Ruby on Rails.",
    ],
  },
  {
    period: "September 2023 - December 2025",
    title: "Full-Stack Developer",
    company:
      "Undercurrent Technologies Pte Ltd (undercurrent.tech), Singapore (Remote)",
    bullets: [
      "Owned 5 backend services in TypeScript and Go for a decentralized exchange platform.",
      "Designed and implemented Telegram-based applications integrated with Web3 wallet services, enabling secure user transactions for a Telegram community of 25,000+ members.",
      "Delivered Phaser.js game features as daily active users grew from 3,000 to 6,000.",
      "Worked in a fully remote, cross-border team of 3 to 6 people, communicating asynchronously via GitHub and Discord.",
    ],
  },
  {
    period: "April 2022 - April 2023",
    title: "Technical Lead",
    company: "TwoSpaces, Kota Tangerang Selatan, Banten, Indonesia",
    bullets: [
      "Led end-to-end delivery of 6 projects, from planning and architecture to deployment and monitoring: payment gateway, merchant, and property management services, a third-party IoT integration, marketing metrics, and a website rebuild.",
      "Rebuilt the website from Laravel to Next.js in 3 weeks.",
      "Moved deployments from manual releases to CI/CD with zero downtime, migrated services from standard VMs to Kubernetes on AWS, and set a weekly release cadence.",
      "Ran a proof of concept with NEC for KYC verification, face payment, and self check-in.",
      "Led 2 junior engineers and worked alongside 2 seniors, mentoring through code reviews, pair programming, and technical guidance.",
    ],
  },
  {
    period: "May 2021 - April 2022",
    title: "Technical Lead",
    company: "Tekno Kreasi Nyata, Tangerang, Indonesia",
    bullets: [
      "Led a 14-person engineering team (4 frontend, 5 backend, 2 database, 1 DevOps, 2 QA), setting technical direction and enforcing coding standards.",
      "Analyzed a client's financial reporting system and proposed moving it to Kafka and microservices, scaling it from 5,000 to 100,000 incoming transactions per minute.",
      "Worked cross-functionally with Customer Support, Finance, the CTO, and the CEO.",
    ],
  },
  {
    period: "April 2019 - May 2021",
    title: "Lead Frontend Engineer",
    company: "Tekno Kreasi Nyata, Tangerang, Indonesia",
    bullets: [
      "Led the frontend team as it grew from 1 to 4 engineers, having joined as the company's first employee.",
      "Owned stack selection for new projects and managed team capacity.",
      "Maintained a B2B white-label product serving 144 tenants, built as single-tenant software running on multi-tenant Kubernetes infrastructure.",
    ],
  },
  {
    period: "November 2018 - April 2019",
    title: "Senior Frontend Engineer",
    company: "Tekno Kreasi Nyata, Tangerang, Indonesia",
    bullets: [
      "Led frontend delivery for lightweight, maintainable web applications.",
      "Developed reusable frontend patterns aligned with business and product requirements.",
      "Built back-office interfaces in React and greenfield projects in Vue and Nuxt.",
    ],
  },
  {
    period: "September 2018 - February 2019",
    title: "Senior Frontend Engineer",
    company: "Coconutlab Ltd, Indonesia",
    bullets: [
      "Built and shipped ULO (ulo.life), a production React Native mobile app with 10,000+ downloads.",
    ],
  },
  {
    period: "June 2017 - September 2018",
    title: "Senior Frontend Engineer",
    company: "Yamisok, Tangerang, Indonesia",
    bullets: [
      "Rebuilt the company website using Vue.js and Bootstrap 4.",
      "Mentored 2 frontend engineers.",
    ],
  },
  {
    period: "May 2016 - June 2017",
    title: "Junior Software Engineer",
    company: "Yamisok, Tangerang, Indonesia",
    bullets: [
      "Translated designs into production HTML and CSS using Bootstrap 3.",
      "Built a gamer portal for online tournaments used by 4,000 players, covering upper and lower bracket systems, feeds, realtime chat, and marketing email.",
      "Supported the Laravel backend alongside frontend work.",
    ],
  },
];

const skillGroups = [
  {
    title: "Workflow",
    tools: [
      "Jira",
      "Confluence",
      "Linear",
      "Miro",
      "Notion",
      "Figma",
      "Slack",
      "System Design",
    ],
    toolClass:
      "bg-light-primary/10 dark:bg-dark-secondary/10 border-light-primary/20 dark:border-dark-secondary/20 hover:bg-light-primary/20 dark:hover:bg-dark-secondary/20",
  },
  {
    title: "Frontend & Backend",
    tools: [
      "React / Next.js",
      "TypeScript",
      "Ruby on Rails",
      "PixiJS",
      "WebGL",
      "Node.js",
      "Python",
      "Go",
      "GraphQL",
      "REST API",
      "PostgreSQL",
      "MongoDB",
      "Redis",
      "Jest / Vitest",
      "Git",
    ],
    toolClass:
      "bg-light-secondary/10 dark:bg-dark-accent/10 border-light-secondary/20 dark:border-dark-accent/20 hover:bg-light-secondary/20 dark:hover:bg-dark-accent/20",
  },
  {
    title: "Cloud & DevOps",
    tools: [
      "Docker",
      "Kubernetes",
      "Terraform",
      "Ansible",
      "AWS",
      "GitHub Actions",
      "Jenkins",
      "Prometheus",
      "Grafana",
      "CloudWatch",
      "Nginx",
      "Linux",
    ],
    toolClass:
      "bg-light-accent/10 dark:bg-dark-accent/10 border-light-accent/20 dark:border-dark-accent/20 hover:bg-light-accent/20 dark:hover:bg-dark-accent/20",
  },
];
---

<Base>
  <main
    id="main"
    class="min-h-screen bg-light-bg dark:bg-dark-bg text-light-accent dark:text-white"
  >
    <!-- Hero Section -->
    <section
      class="relative min-h-screen flex items-center justify-center px-6 py-24 overflow-hidden"
    >
      <div
        class="absolute inset-0 bg-gradient-to-br from-light-primary/20 via-light-secondary/20 to-light-accent/20 dark:from-dark-primary/20 dark:via-dark-secondary/20 dark:to-dark-accent/20"
      >
      </div>
      <DotGrid class="absolute inset-0" />

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <div
          class="inline-block mb-6 px-4 py-2 bg-light-primary/20 dark:bg-dark-accent/20 border border-light-secondary/30 dark:border-dark-accent/30 rounded-full text-sm font-medium"
        >
          AI-assisted B2B products
        </div>
        <div
          class="mb-4 text-sm font-medium tracking-widest text-light-accent dark:text-dark-accent uppercase"
        >
          Senior Software Engineer
        </div>
        <h1
          class="text-4xl sm:text-6xl md:text-7xl font-bold mb-8 bg-clip-text text-transparent bg-gradient-to-r from-light-secondary via-light-accent to-light-secondary dark:from-dark-accent dark:via-light-primary dark:to-dark-accent uppercase"
        >
          Ikhsanuddin Syamsuri
        </h1>

        <p class="max-w-2xl mx-auto mb-10 text-base sm:text-lg leading-relaxed">
          I build AI-assisted product features end to end in React and Ruby on
          Rails, and I led the move of a blueprint canvas to PixiJS/WebGL.
        </p>

        <div class="flex flex-wrap justify-center gap-4 mb-10">
          <a
            href="/Ikhsanuddin Syamsuri - Senior Software Engineer.pdf"
            download
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-semibold text-white bg-gradient-to-r from-light-secondary to-light-accent dark:from-dark-secondary dark:to-dark-accent hover:from-light-accent hover:to-light-secondary dark:hover:from-dark-accent dark:hover:to-dark-secondary transition-colors"
          >
            <Icon name="download" /> Download CV
          </a>
          <a
            href="#section-experience"
            class="inline-flex items-center px-6 py-3 rounded-full font-semibold border border-light-accent/30 dark:border-white/30 hover:bg-light-accent/10 dark:hover:bg-white/10 transition-colors"
          >
            View experience
          </a>
        </div>

        <div
          class="flex flex-wrap justify-center gap-x-6 gap-y-3 mb-12 text-sm"
        >
          <a
            href="mailto:mail.ikhsanuddin@gmail.com"
            class="flex items-center gap-2 hover:text-light-secondary dark:hover:text-dark-accent transition-colors"
          >
            <Icon name="mail" /> mail.ikhsanuddin@gmail.com
          </a>
          <a
            href="https://linkedin.com/in/ikhsanuddin"
            class="flex items-center gap-2 hover:text-light-secondary dark:hover:text-dark-accent transition-colors"
          >
            <Icon name="linkedin" /> linkedin.com/in/ikhsanuddin
          </a>
          <a
            href="https://github.com/ikhsanuddin"
            class="flex items-center gap-2 hover:text-light-secondary dark:hover:text-dark-accent transition-colors"
          >
            <Icon name="github" /> github.com/ikhsanuddin
          </a>
          <span class="flex items-center gap-2">
            <Icon name="map-pin" /> Jakarta, Indonesia (UTC+7)
          </span>
        </div>
      </div>

      <div
        class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce"
        aria-hidden="true"
      >
        <div
          class="w-6 h-10 border-2 border-light-accent/30 dark:border-white/30 rounded-full p-1"
        >
          <div
            class="w-1.5 h-2 bg-light-accent/50 dark:bg-white/50 rounded-full mx-auto animate-pulse"
          >
          </div>
        </div>
      </div>
    </section>

    <!-- Summary Section -->
    <section id="section-summary" class="min-h-screen flex items-center py-20 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-8">
              Summary
            </h2>
            <div
              class="space-y-6 text-light-accent dark:text-gray-300 leading-relaxed"
            >
              <p>
                I have spent 10 years building web products, and since 2023 I
                have worked fully remote with teams in Singapore and the US. At
                Boon I own AI-assisted preconstruction features end to end in
                React and Ruby on Rails, on a takeoff system that handled
                70,000+ runs in 90 days, and I led the Takeoff V2 move to a
                PixiJS/WebGL canvas.
              </p>
              <p>
                Before that I owned 5 backend services in TypeScript and Go for
                a decentralized exchange, and led teams in Indonesia from 2019
                to 2023. As technical lead at Tekno Kreasi Nyata I led a
                14-person team and proposed the Kafka and microservices
                architecture that scaled a client financial reporting system
                from 5,000 to 100,000 incoming transactions per minute.
              </p>
            </div>
          </div>
          <div
            class="p-8 rounded-2xl bg-gradient-to-br from-light-primary/20 to-light-secondary/20 dark:from-dark-primary/20 dark:to-dark-secondary/20 backdrop-blur-sm border border-light-accent/10 dark:border-white/10"
          >
            <h3
              class="text-sm font-medium uppercase tracking-widest text-light-accent dark:text-dark-accent"
            >
              At a glance
            </h3>
            <dl class="mt-6 space-y-5">
              <div>
                <dt class="text-sm text-light-accent dark:text-gray-400">
                  Currently
                </dt>
                <dd class="font-medium">
                  Full-Stack Engineer at Boon (US, remote)
                </dd>
              </div>
              <div>
                <dt class="text-sm text-light-accent dark:text-gray-400">
                  Experience
                </dt>
                <dd class="font-medium">
                  10 years across frontend, backend, and infrastructure
                </dd>
              </div>
              <div>
                <dt class="text-sm text-light-accent dark:text-gray-400">
                  Core stack
                </dt>
                <dd class="font-medium">
                  React, TypeScript, Ruby on Rails, PixiJS/WebGL, Node.js, Go
                </dd>
              </div>
              <div>
                <dt class="text-sm text-light-accent dark:text-gray-400">
                  Location
                </dt>
                <dd class="font-medium">Jakarta, Indonesia (UTC+7)</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- Work Experience Section -->
    <section
      id="section-experience"
      class="min-h-screen py-20 px-6 bg-light-bg dark:bg-[#050505]"
    >
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-16">
          Experience
        </h2>

        <div class="space-y-16">
          {
            experiences.map((exp) => (
              <div class="relative pl-8 border-l-2 border-light-secondary/30 dark:border-dark-secondary/30">
                <div class="absolute left-[-9px] top-0 w-4 h-4 bg-light-secondary dark:bg-dark-accent rounded-full" />
                <div class="mb-2 text-sm text-light-secondary dark:text-dark-accent font-medium">
                  {exp.period}
                </div>
                <h3 class="text-2xl font-bold mb-2">{exp.title}</h3>
                <div class="mb-6 text-light-accent/70 dark:text-gray-400">
                  {exp.company}
                </div>
                <ul class="max-w-3xl space-y-2 text-light-accent dark:text-gray-300">
                  {exp.bullets.map((bullet) => (
                    <li class="flex gap-2">
                      <span class="text-light-secondary dark:text-dark-accent mt-1" aria-hidden="true">
                        →
                      </span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section id="section-skills" class="min-h-screen py-20 px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-16">
          Skills & Tools
        </h2>

        <div class="space-y-12">
          {
            skillGroups.map((group) => (
              <div class="p-6 sm:p-8 bg-light-accent/5 dark:bg-white/5 border border-light-accent/10 dark:border-white/10 rounded-2xl">
                <h3 class="text-2xl sm:text-3xl font-bold mb-6 text-light-secondary dark:text-dark-accent">
                  {group.title}
                </h3>
                <ul class="flex flex-wrap gap-2">
                  {group.tools.map((tool) => (
                    <li
                      class={`px-3 py-1.5 border rounded-full text-sm transition-colors ${group.toolClass}`}
                    >
                      {tool}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section
      id="section-contact"
      class="min-h-screen flex items-center py-20 px-6 bg-light-bg dark:bg-[#050505]"
    >
      <div class="max-w-4xl mx-auto text-center w-full">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-12">
          Let&apos;s Connect
        </h2>

        <div class="grid md:grid-cols-3 gap-6 mb-12">
          <a
            href="mailto:mail.ikhsanuddin@gmail.com"
            class="p-6 bg-light-accent/5 dark:bg-white/5 border border-light-accent/10 dark:border-white/10 rounded-2xl hover:bg-light-accent/10 dark:hover:bg-white/10 transition-[background-color,scale] hover:scale-105"
          >
            <Icon
              name="mail"
              class="text-3xl mb-4 mx-auto text-light-secondary dark:text-dark-accent"
            />
            <div class="font-bold mb-2">Email</div>
            <div class="text-light-accent/70 dark:text-gray-400 text-sm">
              mail.ikhsanuddin@gmail.com
            </div>
          </a>

          <a
            href="https://linkedin.com/in/ikhsanuddin"
            target="_blank"
            rel="noopener noreferrer"
            class="p-6 bg-light-accent/5 dark:bg-white/5 border border-light-accent/10 dark:border-white/10 rounded-2xl hover:bg-light-accent/10 dark:hover:bg-white/10 transition-[background-color,scale] hover:scale-105"
          >
            <Icon
              name="linkedin"
              class="text-3xl mb-4 mx-auto text-light-secondary dark:text-dark-accent"
            />
            <div class="font-bold mb-2">LinkedIn</div>
            <div class="text-light-accent/70 dark:text-gray-400 text-sm">
              linkedin.com/in/ikhsanuddin
            </div>
          </a>

          <a
            href="https://github.com/ikhsanuddin"
            target="_blank"
            rel="noopener noreferrer"
            class="p-6 bg-light-accent/5 dark:bg-white/5 border border-light-accent/10 dark:border-white/10 rounded-2xl hover:bg-light-accent/10 dark:hover:bg-white/10 transition-[background-color,scale] hover:scale-105"
          >
            <Icon
              name="github"
              class="text-3xl mb-4 mx-auto text-light-secondary dark:text-dark-accent"
            />
            <div class="font-bold mb-2">GitHub</div>
            <div class="text-light-accent/70 dark:text-gray-400 text-sm">
              github.com/ikhsanuddin
            </div>
          </a>
        </div>

        <a
          href="/Ikhsanuddin Syamsuri - Senior Software Engineer.pdf"
          download
          class="inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-light-secondary to-light-accent dark:from-dark-secondary dark:to-dark-accent hover:from-light-accent hover:to-light-secondary dark:hover:from-dark-accent dark:hover:to-dark-secondary rounded-full font-bold transition-[--tw-gradient-from,--tw-gradient-to,scale] hover:scale-105 text-white"
        >
          <Icon name="download" class="text-xl" />
          Download CV
        </a>
      </div>
    </section>
  </main>
</Base>
